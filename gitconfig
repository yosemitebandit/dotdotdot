[user]
  name = Matt Ball
  email = matt.ball.2@gmail.com

[color]
  diff = auto
  status = auto
  branch = auto
  ui = auto

[push]
  default = matching

[core]
  editor = vim
	pager = delta

[alias]
  history = log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit --
[init]
	defaultBranch = main
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
	side-by-side = true
[pull]
	rebase = true
[pager]
	diff = delta --paging=always
